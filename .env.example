# HeyGen (릴스 TTS)
HEYGENAI_API_KEY=
HEYGEN_AVATAR_ID=

# Cloudflare R2 (현장 사진 갤러리)
# 대시보드: Cloudflare → R2 → Manage R2 API Tokens
# 토큰 권한: Object Read & Write, 버킷 범위에 goodatsky 포함
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=goodatsky
# R2 public bucket URL 또는 커스텀 도메인 (끝 슬래시 없이)
# 예: https://pub-xxxxxxxx.r2.dev
CF_R2_PUBLIC_URL=
